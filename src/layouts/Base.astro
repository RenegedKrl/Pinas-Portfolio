---
import '../styles/global.css';
import Nav from '../components/Nav.astro';

interface Props { title?: string; description?: string }
const {
  title = 'Pinas Studio',
  description = 'Assessoria digital em SP para negócios que querem vender mais online. Sites que vendem e tráfego que converte.',
} = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#0B0B0B" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=Caveat+Brush&family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Nav />
    <main><slot /></main>
    <script>
      import '../scripts/motion.ts';
    </script>
    <!-- Pinas Kit: não alterar data-pk e data-api -->
    <script is:inline async src="https://pinaskit.vercel.app/w.js" data-pk="2gavapn6vn" data-api="https://qdpwawkeiyvggcfonfsa.supabase.co/functions/v1"></script>
    <script>
      import '../scripts/pinaskit-theme.ts';
    </script>
    <script is:inline>
      // bloqueia menu do botão direito e arrastar mídia
      document.addEventListener("contextmenu", e => e.preventDefault()); // sem menu do botão direito no site todo
      document.addEventListener("dragstart", e => { if (e.target.closest("img, video")) e.preventDefault(); });
    </script>
  </body>
</html>
