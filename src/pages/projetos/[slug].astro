---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';
import ProjectView from '../../components/ProjectView.astro';

export async function getStaticPaths() {
  const all = (await getCollection('projetos', ({ data }) => data.publico)).sort((a, b) => a.data.ordem - b.data.ordem);
  return all.map((p, i) => ({ params: { slug: p.id }, props: { p, next: all[(i + 1) % all.length] } }));
}
const { p, next } = Astro.props;
---
<Base title={`${p.data.titulo} | PINAS.studio`} description={p.data.descricao}>
  <section class="section dark" style="padding-top:120px">
    <div class="wrap">
      <a href="/projetos" class="back">← todos os projetos</a>
      <ProjectView p={p} />
      {next.id !== p.id && <a class="next" href={`/projetos/${next.id}`}>Próximo projeto <span class="red">{next.data.titulo} →</span></a>}
    </div>
  </section>
  <Footer />
</Base>
<style>
  .back { display: inline-block; margin-bottom: 20px; font-weight: 700; text-decoration: none; }
  .next { display: block; margin-top: 64px; font: 800 clamp(32px, 6vw, 80px)/1 var(--f-display); text-decoration: none; }
</style>
