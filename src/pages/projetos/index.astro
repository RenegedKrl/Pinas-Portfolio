---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';
import ProjectView from '../../components/ProjectView.astro';

const projetos = (await getCollection('projetos', ({ data }) => data.publico)).sort((a, b) => a.data.ordem - b.data.ordem);
const cats = ['Todos', 'Site', 'Landing', 'Tráfego', 'Design'];
---
<Base title="Portfólio | Pinas Studio">
  <section class="section dark top">
    <div class="wrap">
      <h1 class="h-xl">Projetos <span class="red">({projetos.length})</span></h1>
      <div class="filters" role="group" aria-label="Filtrar">
        {cats.map((c, i) => <button type="button" data-filter={c} aria-pressed={i === 0 ? 'true' : 'false'}>{c}</button>)}
      </div>
      <div class="tabs">
        {projetos.map((p) => (
          <a href={`/projetos/${p.id}`} class="tab" data-open={p.id} data-cats={p.data.categoria.join(',')}>{p.data.titulo}</a>
        ))}
      </div>
      <div class="grid">
        {projetos.map((p, i) => (
          <a href={`/projetos/${p.id}`} class={`item card ${i % 3 === 0 ? 'tall' : ''}`} data-open={p.id} data-cats={p.data.categoria.join(',')}>
            <div class="thumb">{p.data.capa ? <img src={p.data.capa} alt="" loading="lazy" /> : <span>mockup</span>}</div>
            <div class="meta"><b>{p.data.titulo}</b><small>{p.data.nicho}</small></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <dialog class="win" data-win data-lenis-prevent aria-label="Projeto">
    <button class="close" type="button" data-close aria-label="Fechar">✕</button>
    {projetos.map((p) => <div class="slot" data-slot={p.id} hidden><ProjectView p={p} /></div>)}
  </dialog>
  <Footer />
</Base>

<style>
  .top { padding-top: 140px; min-height: 100svh; }
  .filters, .tabs { display: flex; gap: 10px; overflow-x: auto; padding: 6px 2px; margin-top: 28px; }
  .filters button, .tab { all: unset; cursor: pointer; flex: none; padding: 10px 18px; border-radius: 99px; border: 2px solid var(--paper); font-weight: 700; min-height: 24px; }
  .filters button[aria-pressed='true'], .tab:hover { background: var(--red); border-color: var(--red); }
  .tab { background: var(--white); color: var(--black); border-color: var(--black); box-shadow: 3px 3px 0 var(--red); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); grid-auto-rows: 200px; gap: 22px; margin-top: 40px; }
  .item { display: flex; flex-direction: column; overflow: hidden; text-decoration: none; grid-row: span 2; transition: transform .3s; }
  .item.tall { grid-row: span 3; }
  .item:hover { transform: rotate(-1deg) translateY(-4px); }
  .item[hidden] { display: none; }
  .thumb { flex: 1; overflow: hidden; display: grid; place-items: center; background: repeating-linear-gradient(45deg, #eee 0 12px, #e2ddd5 12px 24px); }
  .thumb img { width: 100%; object-fit: cover; object-position: top; transition: object-position 3s ease; height: 100%; }
  .item:hover .thumb img { object-position: bottom; }
  .meta { padding: 14px 18px; border-top: var(--stroke); display: grid; }
  .meta small { opacity: .65; }

  :global(html.lock) { overflow: hidden; } /* página de trás parada com a janela aberta */
  .win { overscroll-behavior: contain; width: min(1100px, 94vw); max-height: 90vh; padding: 0; border: 0; background: transparent; overflow: auto; }
  .win::backdrop { background: rgb(11 11 11 / .6); backdrop-filter: blur(8px); }
  .win[open] { animation: grow .45s cubic-bezier(.2,1.3,.4,1); }
  @keyframes grow { from { transform: scale(.6) rotateX(14deg); opacity: 0; } }
  .slot.enter { animation: slide .35s ease; }
  @keyframes slide { from { transform: translateX(40px); opacity: 0; } }
  /* fixo no canto da tela: não ocupa espaço ao lado da janela */
  .close { all: unset; cursor: pointer; position: fixed; top: 14px; right: 14px; z-index: 5; width: 44px; height: 44px; display: grid; place-items: center; border-radius: 50%; background: var(--red); color: var(--white); border: 3px solid var(--black); box-shadow: 3px 3px 0 var(--black); font-weight: 800; }
  @media (max-width: 700px) {
    .top { padding-top: 110px; }
    .tabs { display: none; } /* no celular a grade já lista os projetos */
    .grid { grid-template-columns: 1fr; grid-auto-rows: 160px; margin-top: 24px; gap: 18px; }
    .item.tall { grid-row: span 2; }
    /* celular: tela cheia, barra do navegador fixa no topo com o ✕ dentro */
    .win { width: 100vw; max-width: 100vw; height: 100dvh; max-height: 100dvh; margin: 0; background: var(--paper); }
    .win :global(.pv) { border: 0; border-radius: 0; box-shadow: none; min-height: 100%; }
    .win :global(.pv .bar) { position: sticky; top: 0; z-index: 3; min-height: 56px; padding-right: 64px; }
    .close { top: 8px; right: 10px; width: 40px; height: 40px; box-shadow: 2px 2px 0 var(--black); }
    .win[open] { animation: up .4s ease; }
    @keyframes up { from { transform: translateY(100%); } }
  }
</style>

<script>
  const win = document.querySelector<HTMLDialogElement>('[data-win]')!;
  const slots = [...document.querySelectorAll<HTMLElement>('[data-slot]')];
  const show = (id: string, push = true) => {
    slots.forEach((s) => { s.hidden = s.dataset.slot !== id; s.classList.toggle('enter', s.dataset.slot === id && win.open); });
    if (!win.open) { win.showModal(); document.documentElement.classList.add("lock"); (window as any).lenis?.stop(); }
    if (push) history.pushState({ id }, '', `/projetos/${id}`);
  };
  const close = () => { win.close(); };
  win.addEventListener('close', () => { document.documentElement.classList.remove('lock'); (window as any).lenis?.start(); if (location.pathname !== '/projetos') history.pushState({}, '', '/projetos'); });
  win.addEventListener('click', (e) => { if (e.target === win) close(); });
  document.querySelector('[data-close]')!.addEventListener('click', close);
  document.querySelectorAll<HTMLAnchorElement>('[data-open]').forEach((a) => a.addEventListener('click', (e) => { e.preventDefault(); show(a.dataset.open!); }));
  addEventListener('popstate', () => { const id = location.pathname.split('/')[2]; id ? show(id, false) : win.open && win.close(); });

  // filtros
  const btns = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  btns.forEach((b) => b.addEventListener('click', () => {
    btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    const f = b.dataset.filter!;
    document.querySelectorAll<HTMLElement>('[data-cats]').forEach((el) => { el.hidden = f !== 'Todos' && !el.dataset.cats!.split(',').includes(f); });
  }));
</script>
